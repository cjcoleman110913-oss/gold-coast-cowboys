# Set these in Vercel -> Project -> Settings -> Environment Variables
DATABASE_URL=postgres://...            # added automatically when you connect Neon from the Vercel Marketplace
SESSION_SECRET=                        # any long random string (32+ chars)
ADMIN_SETUP_KEY=                       # one-time key needed to create the first admin account
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=https://yourdomain.com      # optional; only if Stripe redirects/invite links show the wrong domain

# Optional: email yourself whenever someone submits the pass redemption form.
# Create a free account at resend.com, verify your domain, then set:
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL=dance@goldcoastcowboys.com      # where notifications go (default shown)
# NOTIFY_FROM=GCC Website <noreply@goldcoastcowboys.com>
